<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FrameMotionPlus.Cuda</RootNamespace>
    <AssemblyName>FrameMotionPlus.Cuda</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameMotionPlus.Core\FrameMotionPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The checked-in PTX (regenerated by native/kernels/build.sh), so a build needs no GPU toolchain. -->
    <EmbeddedResource Include="..\..\native\kernels\ptx\*.ptx" LogicalName="FrameMotionPlus.Cuda.Kernels.%(Filename).ptx" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameMotionPlus.Cuda.Tests" />
    <!-- Its allocation test asserts, through CudaStream's path counters, that the timeline-semaphore waits and signals
         ran (they need a Vulkan exporter, which only that project has). -->
    <InternalsVisibleTo Include="FrameMotionPlus.Gpu.Tests" />
    <!-- VfgGenerator validates frames and signals before it enqueues anything, as CudaFrameGenerator does (FrameChecks,
         CudaStream.ValidateCudaSignal/WaitValidated/SignalValidated); its tests read the same path counters and the
         context's reference count. -->
    <InternalsVisibleTo Include="FrameMotionPlus.Vfx" />
    <InternalsVisibleTo Include="FrameMotionPlus.Vfx.Tests" />
  </ItemGroup>

</Project>
