<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrameMotionPlus.App</RootNamespace>
    <AssemblyName>fmp</AssemblyName>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Concurrent (background) GC stays on: GcLatencyScope's SustainedLowLatency during playback needs it (design doc).
         Only the test projects turn it off, for exact per-thread allocation counters. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameMotionPlus.Core\FrameMotionPlus.Core.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Platform\FrameMotionPlus.Platform.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Cuda\FrameMotionPlus.Cuda.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Vulkan\FrameMotionPlus.Vulkan.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.CudaVulkan\FrameMotionPlus.CudaVulkan.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Vfx\FrameMotionPlus.Vfx.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Sources.File\FrameMotionPlus.Sources.File.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Pipeline\FrameMotionPlus.Pipeline.csproj" />
    <ProjectReference Include="..\FrameMotionPlus.Audio\FrameMotionPlus.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameMotionPlus.Core.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Platform.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Gpu.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Vfx.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Sources.File.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Pipeline.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Sources.V4l2.Tests" />
    <InternalsVisibleTo Include="FrameMotionPlus.Audio.Tests" />
  </ItemGroup>

</Project>
