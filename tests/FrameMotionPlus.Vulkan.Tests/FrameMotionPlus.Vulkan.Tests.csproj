<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrameMotionPlus.Vulkan.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The zero-allocation test reads GC.GetAllocatedBytesForCurrentThread(), which a background (concurrent) gen2
         collection can move on a thread that allocated nothing (see FrameMotionPlus.Core.Tests). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameMotionPlus.Vulkan\FrameMotionPlus.Vulkan.csproj" />
  </ItemGroup>

  <!-- Lets the shader test find native/shaders even when built into an artifacts path outside the checkout. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- One GPU hardware test assembly at a time on a machine: see the remarks in the file. -->
    <Compile Include="..\Shared\GpuMachineLock.cs" Link="Support\GpuMachineLock.cs" />
  </ItemGroup>

</Project>
