<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrameMotionPlus.Platform.Tests</RootNamespace>
    <!-- As in FrameMotionPlus.Core.Tests: the zero-allocation tests read GC.GetAllocatedBytesForCurrentThread(), which
         a background (concurrent) gen2 collection can move on a thread that allocated nothing. Blocking collections
         leave it exact. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Dynamic PGO off in this test host. Under the JIT, re-compiling a LibraryImport P/Invoke stub at a higher tier (with
         PGO, about a second into a run) binds the P/Invoke again, and binding hands the DllImport resolver a newly
         allocated library name on the calling thread: 40 to 88 B that land in a zero-allocation window by chance
         (seen in Phase 3: 6 of 9 runs of the Vfx AllocationTests with the per-frame calls on LibraryImport, none with
         DOTNET_TieredPGO=0). The hot paths here call native code through the same resolver pattern; the published
         NativeAOT binary has no tiers and is unaffected. The runtime-configuration test checks the switch reaches the host. -->
    <TieredPGO>false</TieredPGO>
    <!-- LibraryImport (tgkill, to interrupt a sleep with a signal) generates unsafe stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameMotionPlus.Platform\FrameMotionPlus.Platform.csproj" />
    <!-- fmp bench jitter is tested in-process through the dispatcher. -->
    <ProjectReference Include="..\..\src\FrameMotionPlus.App\FrameMotionPlus.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One timing-sensitive or CPU-heavy test assembly at a time on a machine: see the remarks in the file. -->
    <Compile Include="..\Shared\GpuMachineLock.cs" Link="Support\GpuMachineLock.cs" />
  </ItemGroup>

</Project>
