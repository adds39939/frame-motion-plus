<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrameMotionPlus.Platform.Tests</RootNamespace>
    <!-- As in FrameMotionPlus.Core.Tests: the zero-allocation tests read GC.GetAllocatedBytesForCurrentThread(), which
         a background (concurrent) gen2 collection can move on a thread that allocated nothing. Blocking collections
         leave it exact. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- LibraryImport (tgkill, to interrupt a sleep with a signal) generates unsafe stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameMotionPlus.Platform\FrameMotionPlus.Platform.csproj" />
    <!-- fmp bench jitter is tested in-process through the dispatcher. -->
    <ProjectReference Include="..\..\src\FrameMotionPlus.App\FrameMotionPlus.App.csproj" />
  </ItemGroup>

</Project>
